rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stats/{docId} {
      allow read: if false;
      allow create: if docId == "summary"
        && request.resource.data.keys().hasOnly(["visits", "updatedAt"])
        && request.resource.data.visits == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if docId == "summary"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visits", "updatedAt"])
        && request.resource.data.visits == resource.data.visits + 1
        && request.resource.data.updatedAt == request.time;
    }
  }
}
